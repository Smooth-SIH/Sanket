# Example current weather conditions

live_weather = pd.DataFrame([{
    "temperature": 30,
    "humidity": 90,
    "dew_point": 27,
    "pressure": 996,
    "wind_speed": 8,
    "wind_direction": 240,

    "rainfall_10min": 4,
    "rainfall_1hr": 18,
    "rainfall_3hr": 35,
    "rainfall_24hr": 100,

    "cape": 2200,
    "cin": 20,
    "lifted_index": -5,
    "k_index": 40,

    "wind_shear": 22,
    "wind_convergence": 0.005,

    "iwv": 58,
    "cloud_cover": 95,
    "cloud_top_temperature": -63,

    "elevation": 12,
    "slope": 3.2,
    "soil_moisture": 0.35,

    "latitude": 19.076,
    "longitude": 72.877
}])

# Make sure inputs are in the same order
live_weather = live_weather[features]

# Prediction
prediction = model.predict(live_weather)[0]

# Probability
probability = model.predict_proba(live_weather)[0][1]

if prediction == 1:
    print("🚨 SEVERE WEATHER POSSIBLE")
else:
    print("✅ LOW SEVERE WEATHER RISK")

print("Probability:", round(probability * 100, 2), "%")
