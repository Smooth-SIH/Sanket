# OpenWeatherMap API Key
# Get a free key from https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# ISRO MOSDAC Satellite Ingestion (INSAT-3D / INSAT-3DR / INSAT-3DS)
# Register at https://mosdac.gov.in to get your credentials or API token
MOSDAC_USER=your_mosdac_email@example.com
MOSDAC_PASSWORD=your_mosdac_password
MOSDAC_API_TOKEN=your_mosdac_token_or_credentials

# Ingestion Mode:
# - LIVE_AUTO: Uses OpenWeatherMap surface data + live vertical sounding indices (Recommended)
# - MOSDAC: Direct download and extraction of ISRO MOSDAC HDF5/NetCDF files
# - SIMULATED: Fallback to simulated convective metrics if offline
DATA_SOURCE_MODE=LIVE_AUTO
